{
    "name": "validador/core",
    "description": "Enterprise-grade validation library for Laravel with Oracle database, environment, and git validation support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Vendor",
            "email": "dev@vendor.com"
        }
    ],
    "require": {
        "php": ">=5.6.0",
        "illuminate/support": ">=4.2",
        "illuminate/database": ">=4.2",
        "illuminate/contracts": ">=4.2",
        "illuminate/http": ">=4.2",
        "illuminate/routing": ">=4.2"
    },
    "require-dev": {
        "phpunit/phpunit": ">=5.0",
        "mockery/mockery": ">=0.9",
        "orchestra/testbench": ">=3.0"
    },
    "suggest": {
        "dompdf/dompdf": "Permite descargar el reporte de validación en PDF."
    },
    "autoload": {
        "psr-4": {
            "Vendor\\Validator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vendor\\Validator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vendor\\Validator\\Providers\\ValidatorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
